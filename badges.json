  "filters": [
    {
      "id": "seadex-release",
      "groupId": "release-source",
      "name": "SEADEX",
      "pattern": "(?i)\\b(?:seadex|best[\\s._-]?release|alt[\\s._-]?(?:best[\\s._-]?)?release)\\b|ᴀʟᴛ[\\s._-]?ʙᴇsᴛ[\\s._-]?ʀᴇʟᴇᴀsᴇ|ᴀʟᴛ[\\s._-]?ʀᴇʟᴇᴀsᴇ|ʙᴇsᴛ[\\s._-]?ʀᴇʟᴇᴀsᴇ",
      "imageURL": "https://files.catbox.moe/24qo5p.png",
      "tagColor": "#000000",
      "borderColor": "#FFD500",
      "textColor": "#FFFFFF",
      "tagStyle": "bordered",
      "isEnabled": true,
      "type": "filter"
    },

    {
      "id": "4k-ultra-hd",
      "groupId": "resolution",
      "name": "4K Ultra HD",
      "pattern": "(?i)\\b(4k|2160p|uhd|ultra\\s*hd)\\b",
      "imageURL": "https://raw.githubusercontent.com/leonevz/Elite-Badges/main/Badges/4k_ultra_hd.png",
      "tagColor": "#00000000",
      "borderColor": "#00000000",
      "textColor": "#00000000",
      "tagStyle": "filled and bordered",
      "isEnabled": true,
      "type": "filter"
    },

    {
      "id": "1080p-full-hd",
      "groupId": "resolution",
